export class Chamado {
    #status = "ABERTO";
    #responsavel = null;

    constructor(id, titulo, solicitante) {
        if (id === undefined || id === null || String(id).trim() === "") {
            throw new Error("O id do chamado é obrigatório.");
        }
        if (!titulo || !String(titulo).trim()) {
            throw new Error("O título do chamado é obrigatório.");
        }
        if (!solicitante || !solicitante.matricula) {
            throw new Error("O solicitante deve ser um estudante válido.");
        }

        this.id = String(id);
        this.titulo = String(titulo).trim();
        this.solicitante = solicitante;
    }

    get status() {
        return this.#status;
    }

    get responsavel() {
        return this.#responsavel;
    }

    iniciarAtendimento(responsavel) {
        if (this.#status !== "ABERTO") {
            throw new Error("Somente chamados ABERTOS podem ir para EM_ATENDIMENTO.");
        }
        if (!responsavel || !String(responsavel).trim()) {
            throw new Error("Informe o responsável pelo atendimento.");
        }

        this.#responsavel = String(responsavel).trim();
        this.#status = "EM_ATENDIMENTO";
    }

    finalizar() {
        if (this.#status !== "EM_ATENDIMENTO") {
            throw new Error("Somente chamados EM_ATENDIMENTO podem ser FINALIZADOS.");
        }

        this.#status = "FINALIZADO";
    }

    gerarResumo() {
        return {
            id: this.id,
            titulo: this.titulo,
            solicitante: {
                matricula: this.solicitante.matricula,
                nome: this.solicitante.nome
            },
            responsavel: this.#responsavel,
            status: this.#status
        };
    }
}